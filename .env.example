# Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use
# gemini-3.5-flash  → 1,500 free requests/day  (recommended for development)
# gemini-3.7-flash  → 20 free requests/day      (use for demos)
# gemini-3.8-flash  → not recommended (spec excludes it)
GEMINI_MODEL=gemini-3.5-flash
GEMINI_VISION_MODEL=gemini-3.5-flash

# OpenWeatherMap API key from https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# Default location used when the user doesn't specify one
DEFAULT_LOCATION=Chennai

# Database path (SQLite)
DATABASE_URL=sqlite:///./data/closecall.db

# Image storage directory
IMAGE_STORAGE_PATH=./data/images
